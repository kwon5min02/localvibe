# ── 복사 방법 ─────────────────────────────────────────
#   cp .env.example .env
#   이후 .env 안의 YOUR_* 값만 실제 키로 바꾸세요. .env는 Git에 올리지 마세요.

# ── 필수: DB + 서버 기동 ────────────────────────────
MYSQL_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/localvibe

# ── 필수: AI 아티클 / 챗 (둘 중 하나 이름으로 써도 됨) ─
OPENAI_API_KEY=sk-your-openai-key
# OPEN_API_KEY=   # 일부 코드에서 OPEN_API_KEY 별칭 사용

# ── 필수: 갤러리 의미 검색 (Pinecone 하이브리드) ───
# Dense 384차원: dragonkue/multilingual-e5-small-ko + BM25 sparse (bm25_encoder.json)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=localvibe-hybrid
# 콘솔 대신 CLI로 만들 때 (선택):
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
#   cd back && source .venv/bin/activate && PYTHONPATH=. python scripts/create_pinecone_dense_index.py
#
# KTO 적재 + Pinecone 임베딩 한 번에 (검색과 DB 일치):
#   cd back && PYTHONPATH=. python scripts/sync_kto_places.py
# MySQL만 채울 때: ... python scripts/sync_kto_places.py --db-only

# 선택: 임베딩·BM25 (기본값은 코드와 동일)
# EMBEDDING_MODEL_NAME=dragonkue/multilingual-e5-small-ko
# BM25_MODEL_PATH=bm25_encoder.json
# PINECONE_SEARCH_ALPHA=0.7

# ── 온디맨드 네이버 블로그 크롤 (이미지/텍스트) ─────
# 네이버 개발자센터 > Application > 검색 API(블로그) — HTML이 아니라 검색 API로 URL을 받은 뒤 본문/이미지 크롤
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER_BLOG_MAX_RESULTS=3

# ── 갤러리 검색: Pinecone 후보 배수 (중복 place_id 제거 전) ──
# GALLERY_PINECONE_QUERY_MULTIPLIER=4

# ── 관광 공공 API: KTO(한국관광공사) 중심 ───────────
# KTO_ONLY_MODE=1 이면 전남 레포츠·해수욕장·음식점 등 JN_* 수집은 하지 않습니다.
# 전남 등 JN API까지 쓰려면 KTO_ONLY_MODE=0 + 아래 JN_LEPORTS_SERVICE_KEY 필요.
KTO_SERVICE_KEY=your-data-go-kr-service-key
KTO_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
KTO_AREA_CODES=1,2,3,4,5,6,7,8,31,32,33,34,35,36,37,38,39
KTO_NUM_ROWS=50
KTO_MAX_ITEMS=2000
KTO_DETAIL_MAX=0
KTO_KEYWORDS=서울,부산,대구,인천,광주,대전,울산,제주,수원,전주,포항,창원,속초,강릉,여수,목포,통영,경주
KTO_ONLY_MODE=1
KTO_REQUIRE_KOREAN=1
KTO_REQUEST_INTERVAL=0.6

# API 서버가 요청마다 KTO/JN 원격 수집을 하지 않고 DB만 읽으려면 1 (배치로 DB 채운 뒤 권장)
LV_REGIONS_SKIP_EXTERNAL_FETCH=1

# JN_LEPORTS_SERVICE_KEY=   # KTO_ONLY_MODE=0 일 때만
# JN_API_ENDPOINT_URLS=     # 전남 코스 API base 등 (data/README.md 참고)

# ── 선택: 카카오 지오코딩 등 ───────────────────────
KAKAO_REST_API_KEY=

# ── 선택: Google 로그인 + JWT ──────────────────────
GOOGLE_CLIENT_ID=
JWT_SECRET=change-me-to-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── 선택: 외부 지역 캐시·재시도 (KTO 수집에도 사용) ─
# JN_RUNTIME_CACHE_TTL_SECONDS=120
# JN_EXTERNAL_CACHE_TTL_SECONDS=600
# JN_EXTERNAL_CACHE_STALE_SECONDS=1200
# JN_API_RETRY_COUNT=4
# JN_API_429_WAIT_SECONDS=2.0

# ── 선택: SQL 디버그 ───────────────────────────────
# SQLALCHEMY_ECHO=1

# ── 선택: 갤러리 검색 Top-K ────────────────────────
# GALLERY_SEARCH_TOP_K=20

# ── 선택: 갤러리·트립 DSPy 추천 (갤러리/트립 공통, 기본 비활성) ─
USE_DSPY_GALLERY=false
# DSPY_OPENAI_MODEL=gpt-4o-mini
# DSPY_GALLERY_MODEL_PATH=dspy_gallery_optimized.json

# ── 선택: 트립 플래너 하루 장소 수 (기본 6, 느긋 4·빡빡 8은 메시지 키워드) ─
# TRIP_ITEMS_PER_DAY_DEFAULT=6

# ── 선택: 채팅 추천 랭킹 트렌드 감쇠 가중치 ─────────
# CHAT_TREND_SCORE_WEIGHT=6.0
